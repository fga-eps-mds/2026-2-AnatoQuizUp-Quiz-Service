generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoQuestao {
  MULTIPLA_ESCOLHA
  CERTO_ERRADO
}

enum AlternativaQuestao {
  A
  B
  C
  D
  E
}

enum StatusQuestao {
  ATIVO
  INATIVO
}

enum Dificuldade {
  FACIL
  MEDIA
  DIFICIL
}

enum StatusTurma {
  ATIVA
  INATIVA
}

enum FonteMoeda {
  ACERTO_QUESTAO
  DESBLOQUEIO_CONQUISTA
  COMPRA_ITEM
}

enum StatusResolucaoLista {
  EM_ANDAMENTO
  SUBMETIDA
}

enum TipoConquista {
  STREAK_ACERTOS
  TOTAL_ACERTOS
  TOTAL_ACERTOS_TEMA
  PERCENTUAL_ACERTO_TEMA
}

enum TierConquista {
  BRONZE
  PRATA
  OURO
}

enum TipoItemLoja {
  ICONE_PERFIL
  AVATAR
  TITULO
  PLANO_FUNDO
  MOLDURA
  DICA
  POTENCIALIZADOR
}

enum OrigemItemInventario {
  COMPRA
  CONQUISTA
}

enum TaxonomiaBloom {
  LEMBRAR
  COMPREENDER
  APLICAR
  ANALISAR
  AVALIAR
  CRIAR
}

enum OrigemQuestao {
  LIVRO
  PROVA_ANTERIOR
  GERADA_POR_IA
  ELABORADA_POR_PROFESSOR
}

model Tema {
  id   String @id @default(cuid())
  nome String

  questoes   Questao[]
  conquistas Conquista[]

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  @@map("temas")
}

model Questao {
  id              String             @id @default(cuid())
  enunciado       String
  tipoQuestao     TipoQuestao
  respostaCorreta AlternativaQuestao
  saibaMais       String?
  status          StatusQuestao      @default(ATIVO)
  urlImagem       String?

  taxonomiaBloom  TaxonomiaBloom?
  origemQuestao   OrigemQuestao   @default(ELABORADA_POR_PROFESSOR)
  regiaoAnatomica String?
  palavrasChave   String[]        @default([])

  criadoPorId String
  temaId      String

  questaoOriginalId String?
  questaoOriginal   Questao?  @relation("VersoesQuestao", fields: [questaoOriginalId], references: [id])
  versoes           Questao[] @relation("VersoesQuestao")

  tema             Tema                    @relation(fields: [temaId], references: [id], onDelete: Restrict)
  alternativas     QuestaoAlternativa?
  resolucoes       ResolucaoQuestao[]
  resolucoesListas ResolucaoQuestaoLista[]
  transacoesMoedas TransacaoMoeda[]

  listas ListaQuestaoItem[]

  dificuldade Dificuldade @default(MEDIA)

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  @@map("questoes")
}

model QuestaoAlternativa {
  id String @id @default(cuid())

  alternativaA String
  alternativaB String
  alternativaC String
  alternativaD String
  alternativaE String

  questaoId String  @unique
  questao   Questao @relation(fields: [questaoId], references: [id], onDelete: Restrict)

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  @@map("questoes_alternativas")
}

model ResolucaoQuestao {
  id              String             @id @default(cuid())
  respostaMarcada AlternativaQuestao

  usuarioId String
  questaoId String

  questao Questao @relation(fields: [questaoId], references: [id], onDelete: Restrict)

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  @@map("resolucoes_questoes")
}

model CarteiraMoedas {
  id        String @id @default(cuid())
  usuarioId String @unique
  saldo     Int    @default(0)

  transacoes TransacaoMoeda[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("carteiras_moedas")
}

model ItemLoja {
  id String @id @default(cuid())

  codigo    String  @unique
  nome      String
  descricao String?

  tipo TipoItemLoja

  precoMoedas Int

  // Cor (hex) ou chave de textura para PLANO_FUNDO; null nas demais categorias.
  valor String?

  imagemUrl        String?
  previewImagemUrl String?

  ativo            Boolean @default(true)
  disponivelNaLoja Boolean @default(true)

  // Consumivel (DICA/POTENCIALIZADOR) pode ser comprado varias vezes e acumula
  // quantidade no inventario; cosmeticos continuam com uma unica unidade.
  consumivel Boolean @default(false)
  // Texto do efeito exibido na loja (ex.: "+30 segundos na questao").
  efeito     String?

  inventarios          InventarioItem[]
  transacoesMoedas     TransacaoMoeda[]
  recompensasConquista RecompensaItemConquista[]

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  @@index([tipo])
  @@index([ativo])
  @@index([disponivelNaLoja])
  @@map("itens_loja")
}

model InventarioItem {
  id String @id @default(cuid())

  usuarioId              String
  itemLojaId             String
  desbloqueioConquistaId String?

  equipado Boolean              @default(false)
  origem   OrigemItemInventario @default(COMPRA)

  // Unidades possuidas; so passa de 1 em itens consumiveis.
  quantidade Int @default(1)

  adquiridoEm DateTime @default(now())

  itemLoja             ItemLoja              @relation(fields: [itemLojaId], references: [id], onDelete: Restrict)
  desbloqueioConquista DesbloqueioConquista? @relation(fields: [desbloqueioConquistaId], references: [id], onDelete: SetNull)

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  @@unique([usuarioId, itemLojaId])
  @@index([usuarioId])
  @@index([itemLojaId])
  @@index([desbloqueioConquistaId])
  @@map("inventario_itens")
}

model TransacaoMoeda {
  id String @id @default(cuid())

  usuarioId String

  questaoId     String?
  desbloqueioId String?
  itemLojaId    String?

  quantidade Int
  fonte      FonteMoeda @default(ACERTO_QUESTAO)

  // Unidades compradas nesta transacao (so em COMPRA_ITEM).
  quantidadeItem Int?

  descricao String?

  carteira CarteiraMoedas @relation(fields: [usuarioId], references: [usuarioId], onDelete: Restrict)

  questao     Questao?              @relation(fields: [questaoId], references: [id], onDelete: Restrict)
  desbloqueio DesbloqueioConquista? @relation(fields: [desbloqueioId], references: [id], onDelete: Restrict)
  itemLoja    ItemLoja?             @relation(fields: [itemLojaId], references: [id], onDelete: Restrict)

  criadoEm DateTime @default(now())

  @@unique([usuarioId, questaoId, fonte])
  @@unique([usuarioId, desbloqueioId, fonte])
  @@index([usuarioId])
  @@index([questaoId])
  @@index([itemLojaId])
  @@map("transacoes_moedas")
}

model Turma {
  id        String      @id @default(cuid())
  codigo    String      @unique
  nome      String
  semestre  String
  ano       Int
  descricao String
  status    StatusTurma @default(ATIVA)

  professorId String

  alunos TurmaAluno[]

  listas ListaTurma[]

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  @@index([professorId])
  @@map("turmas")
}

model TurmaAluno {
  id String @id @default(cuid())

  turmaId String
  alunoId String

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Restrict)

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  @@unique([turmaId, alunoId])
  @@index([alunoId])
  @@map("turmas_alunos")
}

model ListaQuestao {
  id          String @id @default(cuid())
  nome        String
  criadoPorId String

  itens  ListaQuestaoItem[]
  turmas ListaTurma[]

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  @@map("listas_questoes")
}

model ListaQuestaoItem {
  id             String @id @default(cuid())
  listaQuestaoId String
  questaoId      String
  ordem          Int

  listaQuestao ListaQuestao @relation(fields: [listaQuestaoId], references: [id], onDelete: Cascade)
  questao      Questao      @relation(fields: [questaoId], references: [id], onDelete: Restrict)

  @@unique([listaQuestaoId, questaoId])
  @@map("listas_questoes_itens")
}

model ListaTurma {
  id               String    @id @default(cuid())
  listaQuestaoId   String
  turmaId          String
  prazo            DateTime?
  gabaritoLiberado Boolean   @default(false)

  listaQuestao ListaQuestao     @relation(fields: [listaQuestaoId], references: [id], onDelete: Cascade)
  turma        Turma            @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  resolucoes   ResolucaoLista[]

  criadoEm DateTime @default(now())

  @@unique([listaQuestaoId, turmaId])
  @@map("listas_turmas")
}

model ResolucaoLista {
  id           String @id @default(cuid())
  alunoId      String
  listaTurmaId String

  status      StatusResolucaoLista @default(EM_ANDAMENTO)
  submissaoEm DateTime?

  listaTurma ListaTurma              @relation(fields: [listaTurmaId], references: [id], onDelete: Cascade)
  respostas  ResolucaoQuestaoLista[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([alunoId, listaTurmaId])
  @@index([listaTurmaId])
  @@index([alunoId])
  @@map("resolucoes_listas")
}

model ResolucaoQuestaoLista {
  id               String             @id @default(cuid())
  resolucaoListaId String
  questaoId        String
  respostaMarcada  AlternativaQuestao

  resolucaoLista ResolucaoLista @relation(fields: [resolucaoListaId], references: [id], onDelete: Cascade)
  questao        Questao        @relation(fields: [questaoId], references: [id], onDelete: Restrict)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([resolucaoListaId, questaoId])
  @@index([questaoId])
  @@map("resolucoes_questoes_listas")
}

model Conquista {
  id String @id @default(cuid())

  nome          String
  descricao     String
  tipoConquista TipoConquista

  temaId String?
  ativo  Boolean @default(true)

  tema Tema? @relation(fields: [temaId], references: [id], onDelete: Restrict)

  usuarios         ConquistaUsuario[]
  desbloqueios     DesbloqueioConquista[]
  recompensasItens RecompensaItemConquista[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([tipoConquista])
  @@index([temaId])
  @@map("conquistas")
}

model ConquistaUsuario {
  id String @id @default(cuid())

  usuarioId String

  conquistaId String

  valorProgresso Int @default(0)

  conquista Conquista @relation(fields: [conquistaId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([usuarioId, conquistaId])
  @@index([usuarioId])
  @@index([conquistaId])
  @@map("conquistas_usuarios")
}

model DesbloqueioConquista {
  id String @id @default(cuid())

  usuarioId String

  conquistaId String

  tier TierConquista

  destaque Boolean @default(false)

  conquistadoEm DateTime @default(now())

  conquista       Conquista        @relation(fields: [conquistaId], references: [id], onDelete: Cascade)
  transacaoMoedas TransacaoMoeda[]
  itensInventario InventarioItem[]

  @@unique([usuarioId, conquistaId, tier])
  @@index([usuarioId])
  @@index([conquistaId])
  @@map("desbloqueios_conquistas")
}

model RecompensaItemConquista {
  id String @id @default(cuid())

  conquistaId String
  tier        TierConquista
  itemLojaId  String

  conquista Conquista @relation(fields: [conquistaId], references: [id], onDelete: Cascade)
  itemLoja  ItemLoja  @relation(fields: [itemLojaId], references: [id], onDelete: Restrict)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([conquistaId, tier])
  @@index([itemLojaId])
  @@map("recompensas_itens_conquistas")
}
