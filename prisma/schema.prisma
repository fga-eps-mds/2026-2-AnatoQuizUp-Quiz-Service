generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoQuestao {
  MULTIPLA_ESCOLHA
  CERTO_ERRADO
}

enum AlternativaQuestao {
  A
  B
  C
  D
  E
}

enum StatusQuestao {
  ATIVO
  INATIVO
}

enum Dificuldade {
  FACIL
  MEDIA
  DIFICIL
}

enum StatusTurma {
  ATIVA
  INATIVA
}

enum FonteMoeda {
  ACERTO_QUESTAO
  DESBLOQUEIO_CONQUISTA
  COMPRA_ITEM
  USO_POTENCIALIZADOR
}

enum StatusTentativaQuiz {
  EM_ANDAMENTO
  CONCLUIDA
}

enum OrigemXp {
  QUIZ_CONCLUIDO
  MISSAO_CONCLUIDA
}

enum EloXp {
  CURIOSO
  ACADEMICO
  INTERNO
  R1
  R3
  R6
  STAFF_DO_SERVICO
}

// Estado do elo quanto a inatividade do estudante (US #89).
enum EstadoElo {
  ATIVO
  EM_RISCO
  REBAIXADO
}

// Evento registrado no historico de progressao de elo.
enum TipoEventoElo {
  PROMOCAO
  REBAIXAMENTO
  RECUPERACAO
}

// Avisos enviados ao estudante ao longo do ciclo de inatividade.
enum TipoNotificacaoElo {
  AVISO_PREVENTIVO
  ELO_EM_RISCO
  VESPERA_REBAIXAMENTO
  ELO_REBAIXADO
  ELO_RECUPERADO
}

enum StatusResolucaoLista {
  EM_ANDAMENTO
  SUBMETIDA
}

enum TipoConquista {
  STREAK_ACERTOS
  TOTAL_ACERTOS
  TOTAL_ACERTOS_TEMA
  PERCENTUAL_ACERTO_TEMA
}

enum TierConquista {
  BRONZE
  PRATA
  OURO
}

enum TipoItemLoja {
  ICONE_PERFIL
  AVATAR
  TITULO
  PLANO_FUNDO
  MOLDURA
  ROSTO
  CABELO
  DICA
  POTENCIALIZADOR
}

enum OrigemItemInventario {
  COMPRA
  CONQUISTA
}

// Efeitos executaveis pelo backend. O campo textual `efeito` continua sendo
// somente a descricao exibida na interface; esta enumeracao evita que a regra
// de negocio dependa de comparar textos ou codigos livres do catalogo.
enum TipoEfeitoItem {
  DOBRAR_MOEDAS_PROXIMO_ACERTO
}

enum StatusUsoItem {
  ATIVO
  APLICADO
}

enum TaxonomiaBloom {
  LEMBRAR
  COMPREENDER
  APLICAR
  ANALISAR
  AVALIAR
  CRIAR
}

enum OrigemQuestao {
  LIVRO
  PROVA_ANTERIOR
  GERADA_POR_IA
  ELABORADA_POR_PROFESSOR
}

model Tema {
  id   String @id @default(cuid())
  nome String

  questoes   Questao[]
  conquistas Conquista[]

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  @@map("temas")
}

model Questao {
  id              String             @id @default(cuid())
  enunciado       String
  tipoQuestao     TipoQuestao
  respostaCorreta AlternativaQuestao
  saibaMais       String?
  status          StatusQuestao      @default(ATIVO)
  urlImagem       String?

  taxonomiaBloom  TaxonomiaBloom?
  origemQuestao   OrigemQuestao   @default(ELABORADA_POR_PROFESSOR)
  regiaoAnatomica String?
  palavrasChave   String[]        @default([])

  criadoPorId String
  temaId      String

  questaoOriginalId String?
  questaoOriginal   Questao?  @relation("VersoesQuestao", fields: [questaoOriginalId], references: [id])
  versoes           Questao[] @relation("VersoesQuestao")

  tema             Tema                    @relation(fields: [temaId], references: [id], onDelete: Restrict)
  alternativas     QuestaoAlternativa?
  resolucoes       ResolucaoQuestao[]
  resolucoesListas ResolucaoQuestaoLista[]
  transacoesMoedas TransacaoMoeda[]
  usosItens        UsoItem[]

  listas ListaQuestaoItem[]

  dificuldade Dificuldade @default(MEDIA)

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  @@map("questoes")
}

model QuestaoAlternativa {
  id String @id @default(cuid())

  alternativaA String
  alternativaB String
  alternativaC String
  alternativaD String
  alternativaE String

  questaoId String  @unique
  questao   Questao @relation(fields: [questaoId], references: [id], onDelete: Restrict)

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  @@map("questoes_alternativas")
}

model ResolucaoQuestao {
  id              String             @id @default(cuid())
  respostaMarcada AlternativaQuestao

  usuarioId String
  questaoId String

  // Rodada de quiz a que a resposta pertence (null = resposta avulsa/legada).
  tentativaId String?

  questao   Questao        @relation(fields: [questaoId], references: [id], onDelete: Restrict)
  tentativa TentativaQuiz? @relation(fields: [tentativaId], references: [id], onDelete: SetNull)

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  // Dentro de uma rodada, cada questao so pode ser respondida uma vez.
  @@unique([tentativaId, questaoId])
  @@map("resolucoes_questoes")
}

// Rodada finita de quiz (ate 10 questoes). Concluir a rodada e o que concede XP.
model TentativaQuiz {
  id        String @id @default(cuid())
  usuarioId String

  // Filtros escolhidos na tela de quiz (null = sem filtro / quiz aleatorio).
  tema        String?
  dificuldade Dificuldade?

  // Questoes sorteadas para a rodada, na ordem em que foram entregues.
  questaoIds    String[]
  totalQuestoes Int
  totalAcertos  Int?

  status      StatusTentativaQuiz @default(EM_ANDAMENTO)
  iniciadaEm  DateTime            @default(now())
  concluidaEm DateTime?

  respostas   ResolucaoQuestao[]
  transacaoXp TransacaoXp?

  @@index([usuarioId, iniciadaEm])
  @@map("tentativas_quiz")
}

// Saldos de XP e elo do estudante.
//
// xpTotal  : todo o XP ja conquistado. Permanente, nunca reduzido; base do nivel e do ranking.
// xpElo    : pontuacao que determina o elo. Cresce junto com o xpTotal, mas e reduzida por
//            inatividade (rebaixamento), por isso vive num campo proprio.
// eloAtual : elo exibido no perfil e no ranking. Pode cair por inatividade.
// maiorElo : maior elo ja conquistado. So cresce, preservado durante todo o rebaixamento.
model ProgressoXp {
  id        String @id @default(cuid())
  usuarioId String @unique
  xpTotal   Int    @default(0)
  xpElo     Int    @default(0)
  eloAtual  EloXp  @default(CURIOSO)
  maiorElo  EloXp  @default(CURIOSO)

  // Ultima atividade que concedeu XP. null = estudante nunca pontuou (nao sofre rebaixamento).
  ultimaAtividadeEm DateTime?

  // Rebaixamentos ja aplicados no ciclo de inatividade corrente. Zerado por atividade valida.
  // E o que torna a rotina de verificacao idempotente (reexecutar nao rebaixa de novo).
  rebaixamentosAplicados Int @default(0)

  transacoes  TransacaoXp[]
  eventosElo  EventoElo[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("progressos_xp")
}

// Historico de progressao de elo: promocoes, rebaixamentos por inatividade e recuperacoes.
model EventoElo {
  id        String @id @default(cuid())
  usuarioId String

  tipo        TipoEventoElo
  eloAnterior EloXp
  eloNovo     EloXp

  xpEloAntes  Int
  xpEloDepois Int

  // Dias de inatividade que motivaram o rebaixamento (null nas promocoes/recuperacoes).
  diasInatividade Int?

  progresso ProgressoXp @relation(fields: [usuarioId], references: [usuarioId], onDelete: Restrict)

  criadoEm DateTime @default(now())

  @@index([usuarioId, criadoEm])
  @@map("eventos_elo")
}

// Avisos de inatividade, rebaixamento e recuperacao destinados a um unico estudante.
// A chave de deduplicacao amarra o aviso ao ciclo de inatividade que o gerou, para que a
// rotina possa rodar quantas vezes quiser sem repetir a mesma notificacao.
model NotificacaoElo {
  id        String @id @default(cuid())
  usuarioId String

  tipo  TipoNotificacaoElo
  chave String

  titulo   String
  mensagem String

  eloRelacionado      EloXp?
  prazoRebaixamentoEm DateTime?

  lidaEm   DateTime?
  criadoEm DateTime  @default(now())

  @@unique([usuarioId, tipo, chave])
  @@index([usuarioId, criadoEm])
  @@map("notificacoes_elo")
}

// Linha unica (id "global") com os prazos da regra de inatividade. Editavel apenas pelo
// papel ADMINISTRADOR; os valores padrao sao os da US #89.
model ConfiguracaoInatividade {
  id String @id @default("global")

  diasAviso              Int @default(7)
  diasRisco              Int @default(8)
  diasRebaixamento       Int @default(9)
  diasEntreRebaixamentos Int @default(14)

  // Indisponibilidades reconhecidas da plataforma: [{ "inicio": ISO, "fim": ISO }].
  // O tempo dentro dessas janelas nao conta como inatividade do estudante.
  indisponibilidades Json @default("[]")

  atualizadoPorId String?
  atualizadoEm    DateTime @updatedAt

  @@map("configuracao_inatividade")
}

// Historico de XP recebido. tentativaId unico garante que a mesma rodada nao paga duas vezes.
model TransacaoXp {
  id String @id @default(cuid())

  usuarioId   String
  tentativaId String? @unique
  missaoUsuarioId String? @unique

  origem OrigemXp @default(QUIZ_CONCLUIDO)

  xpBase          Int
  bonusDesempenho Int
  bonusPowerUp    Int @default(0)
  quantidade      Int

  // XP acumulado logo apos esta transacao (permite reconstruir o nivel da epoca).
  xpTotalApos Int

  // XP de elo logo apos esta transacao. Diferente do xpTotalApos depois de um
  // rebaixamento, e o que permite reconstruir o elo da epoca numa chamada repetida.
  xpEloApos Int @default(0)

  progresso ProgressoXp    @relation(fields: [usuarioId], references: [usuarioId], onDelete: Restrict)
  tentativa TentativaQuiz? @relation(fields: [tentativaId], references: [id], onDelete: Restrict)
  missaoUsuario MissaoUsuario? @relation(fields: [missaoUsuarioId], references: [id], onDelete: Restrict)

  criadoEm DateTime @default(now())

  @@index([usuarioId, criadoEm])
  @@map("transacoes_xp")
}

model CarteiraMoedas {
  id        String @id @default(cuid())
  usuarioId String @unique
  saldo     Int    @default(0)

  transacoes TransacaoMoeda[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("carteiras_moedas")
}

model ItemLoja {
  id String @id @default(cuid())

  codigo    String  @unique
  nome      String
  descricao String?

  tipo TipoItemLoja

  precoMoedas Int

  // Cor (hex) ou chave de textura para PLANO_FUNDO; null nas demais categorias.
  valor String?

  imagemUrl        String?
  previewImagemUrl String?

  ativo            Boolean @default(true)
  disponivelNaLoja Boolean @default(true)

  // Consumivel (DICA/POTENCIALIZADOR) pode ser comprado varias vezes e acumula
  // quantidade no inventario; cosmeticos continuam com uma unica unidade.
  consumivel Boolean @default(false)
  // Texto do efeito exibido na loja (ex.: "+30 segundos na questao").
  efeito     String?
  tipoEfeito TipoEfeitoItem?

  inventarios          InventarioItem[]
  transacoesMoedas     TransacaoMoeda[]
  recompensasConquista RecompensaItemConquista[]
  usos                 UsoItem[]

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  @@index([tipo])
  @@index([ativo])
  @@index([disponivelNaLoja])
  @@map("itens_loja")
}

model InventarioItem {
  id String @id @default(cuid())

  usuarioId              String
  itemLojaId             String
  desbloqueioConquistaId String?

  equipado Boolean              @default(false)
  origem   OrigemItemInventario @default(COMPRA)

  // Unidades possuidas; so passa de 1 em itens consumiveis.
  quantidade Int @default(1)

  adquiridoEm DateTime @default(now())

  itemLoja             ItemLoja              @relation(fields: [itemLojaId], references: [id], onDelete: Restrict)
  desbloqueioConquista DesbloqueioConquista? @relation(fields: [desbloqueioConquistaId], references: [id], onDelete: SetNull)

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  @@unique([usuarioId, itemLojaId])
  @@index([usuarioId])
  @@index([itemLojaId])
  @@index([desbloqueioConquistaId])
  @@map("inventario_itens")
}

// Cada ativacao de consumivel vira um registro proprio. `chaveUsoPendente` e
// unica enquanto preenchida: ela impede atomicamente dois cafes ativos para o
// mesmo usuario/efeito, mas permite manter todos os usos ja aplicados (null).
model UsoItem {
  id String @id @default(cuid())

  usuarioId String
  itemLojaId String
  tipoEfeito TipoEfeitoItem
  status     StatusUsoItem @default(ATIVO)

  chaveUsoPendente String? @unique
  questaoId         String?
  ativadoEm         DateTime @default(now())
  aplicadoEm        DateTime?

  itemLoja ItemLoja @relation(fields: [itemLojaId], references: [id], onDelete: Restrict)
  questao  Questao? @relation(fields: [questaoId], references: [id], onDelete: Restrict)

  @@index([usuarioId, ativadoEm])
  @@index([usuarioId, status])
  @@index([questaoId])
  @@map("usos_itens")
}

model TransacaoMoeda {
  id String @id @default(cuid())

  usuarioId String

  questaoId     String?
  desbloqueioId String?
  itemLojaId    String?

  quantidade Int
  fonte      FonteMoeda @default(ACERTO_QUESTAO)

  // Unidades compradas nesta transacao (so em COMPRA_ITEM).
  quantidadeItem Int?

  descricao String?

  carteira CarteiraMoedas @relation(fields: [usuarioId], references: [usuarioId], onDelete: Restrict)

  questao     Questao?              @relation(fields: [questaoId], references: [id], onDelete: Restrict)
  desbloqueio DesbloqueioConquista? @relation(fields: [desbloqueioId], references: [id], onDelete: Restrict)
  itemLoja    ItemLoja?             @relation(fields: [itemLojaId], references: [id], onDelete: Restrict)

  criadoEm DateTime @default(now())

  @@unique([usuarioId, questaoId, fonte])
  @@unique([usuarioId, desbloqueioId, fonte])
  @@index([usuarioId])
  @@index([questaoId])
  @@index([itemLojaId])
  @@map("transacoes_moedas")
}

model Turma {
  id        String      @id @default(cuid())
  codigo    String      @unique
  nome      String
  semestre  String
  ano       Int
  descricao String
  status    StatusTurma @default(ATIVA)

  professorId String

  alunos TurmaAluno[]

  listas ListaTurma[]

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  @@index([professorId])
  @@map("turmas")
}

model TurmaAluno {
  id String @id @default(cuid())

  turmaId String
  alunoId String

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Restrict)

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  @@unique([turmaId, alunoId])
  @@index([alunoId])
  @@map("turmas_alunos")
}

model ListaQuestao {
  id          String @id @default(cuid())
  nome        String
  criadoPorId String

  itens  ListaQuestaoItem[]
  turmas ListaTurma[]

  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  excluidoEm   DateTime?

  @@map("listas_questoes")
}

model ListaQuestaoItem {
  id             String @id @default(cuid())
  listaQuestaoId String
  questaoId      String
  ordem          Int

  listaQuestao ListaQuestao @relation(fields: [listaQuestaoId], references: [id], onDelete: Cascade)
  questao      Questao      @relation(fields: [questaoId], references: [id], onDelete: Restrict)

  @@unique([listaQuestaoId, questaoId])
  @@map("listas_questoes_itens")
}

model ListaTurma {
  id               String    @id @default(cuid())
  listaQuestaoId   String
  turmaId          String
  prazo            DateTime?
  gabaritoLiberado Boolean   @default(false)

  listaQuestao ListaQuestao     @relation(fields: [listaQuestaoId], references: [id], onDelete: Cascade)
  turma        Turma            @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  resolucoes   ResolucaoLista[]

  criadoEm DateTime @default(now())

  @@unique([listaQuestaoId, turmaId])
  @@map("listas_turmas")
}

model ResolucaoLista {
  id           String @id @default(cuid())
  alunoId      String
  listaTurmaId String

  status      StatusResolucaoLista @default(EM_ANDAMENTO)
  submissaoEm DateTime?

  listaTurma ListaTurma              @relation(fields: [listaTurmaId], references: [id], onDelete: Cascade)
  respostas  ResolucaoQuestaoLista[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([alunoId, listaTurmaId])
  @@index([listaTurmaId])
  @@index([alunoId])
  @@map("resolucoes_listas")
}

model ResolucaoQuestaoLista {
  id               String             @id @default(cuid())
  resolucaoListaId String
  questaoId        String
  respostaMarcada  AlternativaQuestao

  resolucaoLista ResolucaoLista @relation(fields: [resolucaoListaId], references: [id], onDelete: Cascade)
  questao        Questao        @relation(fields: [questaoId], references: [id], onDelete: Restrict)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([resolucaoListaId, questaoId])
  @@index([questaoId])
  @@map("resolucoes_questoes_listas")
}

model Conquista {
  id String @id @default(cuid())

  nome          String
  descricao     String
  tipoConquista TipoConquista

  temaId String?
  ativo  Boolean @default(true)

  tema Tema? @relation(fields: [temaId], references: [id], onDelete: Restrict)

  usuarios         ConquistaUsuario[]
  desbloqueios     DesbloqueioConquista[]
  recompensasItens RecompensaItemConquista[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([tipoConquista])
  @@index([temaId])
  @@map("conquistas")
}

model ConquistaUsuario {
  id String @id @default(cuid())

  usuarioId String

  conquistaId String

  valorProgresso Int @default(0)

  conquista Conquista @relation(fields: [conquistaId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([usuarioId, conquistaId])
  @@index([usuarioId])
  @@index([conquistaId])
  @@map("conquistas_usuarios")
}

model DesbloqueioConquista {
  id String @id @default(cuid())

  usuarioId String

  conquistaId String

  tier TierConquista

  destaque Boolean @default(false)

  conquistadoEm DateTime @default(now())

  conquista       Conquista        @relation(fields: [conquistaId], references: [id], onDelete: Cascade)
  transacaoMoedas TransacaoMoeda[]
  itensInventario InventarioItem[]

  @@unique([usuarioId, conquistaId, tier])
  @@index([usuarioId])
  @@index([conquistaId])
  @@map("desbloqueios_conquistas")
}

model RecompensaItemConquista {
  id String @id @default(cuid())

  conquistaId String
  tier        TierConquista
  itemLojaId  String

  conquista Conquista @relation(fields: [conquistaId], references: [id], onDelete: Cascade)
  itemLoja  ItemLoja  @relation(fields: [itemLojaId], references: [id], onDelete: Restrict)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([conquistaId, tier])
  @@index([itemLojaId])
  @@map("recompensas_itens_conquistas")
}


enum TipoMissao {
  RESPONDER_QUESTOES
  ACERTAR_QUESTOES
  CONCLUIR_QUIZZES
}

enum PeriodicidadeMissao {
  DIARIA
  SEMANAL
}

model MissaoCatalogo {
  id String @id @default(cuid())
  codigo String @unique
  nome String
  descricao String
  tipo TipoMissao
  periodicidade PeriodicidadeMissao @default(DIARIA)
  meta Int
  recompensaXp Int
  ativa Boolean @default(true)
  missoes MissaoUsuario[]
  @@map("missoes_catalogo")
}

model PeriodoMissoes {
  id String @id @default(cuid())
  usuarioId String
  periodicidade PeriodicidadeMissao @default(DIARIA)
  inicio DateTime
  fim DateTime
  missoes MissaoUsuario[]
  eventos EventoMissao[]
  @@unique([usuarioId, periodicidade, inicio])
  @@map("periodos_missoes")
}

model MissaoUsuario {
  id String @id @default(cuid())
  periodoId String
  missaoId String
  progresso Int @default(0)
  concluidaEm DateTime?
  periodo PeriodoMissoes @relation(fields: [periodoId], references: [id], onDelete: Restrict)
  missao MissaoCatalogo @relation(fields: [missaoId], references: [id], onDelete: Restrict)
  transacaoXp TransacaoXp?
  @@unique([periodoId, missaoId])
  @@map("missoes_usuario")
}

model EventoMissao {
  id String @id @default(cuid())
  periodoId String
  tipo String
  chave String
  periodo PeriodoMissoes @relation(fields: [periodoId], references: [id], onDelete: Restrict)
  @@unique([periodoId, tipo, chave])
  @@map("eventos_missao")
}
